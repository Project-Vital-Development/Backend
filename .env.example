# ─────────────────────────────────────────────────────────────────────────────
# Project Vital — Variáveis de Ambiente (TEMPLATE)
#
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores reais no .env (NUNCA commitar o .env)
#   3. O .env é lido automaticamente pelo Docker Compose
#
# IMPORTANTE:
#   - JWT_SECRET deve ter no mínimo 32 caracteres aleatórios
#   - Senhas devem ser fortes em produção
#   - Variáveis SENSIVEIS estão marcadas com [SENSIVEL]
# ─────────────────────────────────────────────────────────────────────────────


# ── MySQL (Banco de Dados) ───────────────────────────────────────────────────
# Credenciais do container MySQL e da aplicação
MYSQL_ROOT_PASSWORD=change_me_root_password   # [SENSIVEL] Senha root do MySQL
MYSQL_DATABASE=projectvital                    # Nome do banco criado automaticamente

# Usuário da aplicação backend (.NET) — permissões DML/DDL
DB_USER=vital_app                              # Usuário usado pelo backend para EF Core
DB_PASSWORD=change_me_app_password             # [SENSIVEL] Senha do usuário do backend

# Usuário do ML Service — APENAS LEITURA (SELECT)
# Criar manualmente no MySQL após o primeiro startup:
#   CREATE USER 'vital_ml'@'%' IDENTIFIED BY 'sua_senha';
#   GRANT SELECT ON projectvital.* TO 'vital_ml'@'%';
ML_DB_USER=vital_ml                            # Usuário read-only para ML
ML_DB_PASSWORD=change_me_ml_password           # [SENSIVEL] Senha do usuário ML


# ── Backend .NET ─────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development             # Development | Staging | Production

# JWT
JWT_SECRET=change_me_min_32_chars_random_secret_key_for_signing_tokens  # [SENSIVEL]
JWT_EXPIRY_HOURS=24                            # Tempo de expiração do token em horas

# ML Service Client (URL interna do Docker)
ML_SERVICE_TIMEOUT_SECONDS=30                  # Timeout HTTP para chamadas ao ML


# ── Frontend React ───────────────────────────────────────────────────────────
# URL relativa: Vite proxy (dev) ou nginx (Docker) encaminha para o backend.
# Não altere para um host absoluto — quebraria o setup Docker.
VITE_GRAPHQL_URL=/graphql


# ── Observações ──────────────────────────────────────────────────────────────
# A URL ML_SERVICE_URL é fixada no docker-compose.yml como http://ml-service:8000
# (resolução por nome de serviço dentro da rede projectvital-net)
#
# Para gerar um JWT_SECRET forte:
#   openssl rand -base64 48
#   ou no PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object {Get-Random -Maximum 256}))
